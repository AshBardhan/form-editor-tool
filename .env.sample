# Mock Mode - Set to 'enabled' for offline development with mock data
NEXT_PUBLIC_API_MOCKING=

# Database connection string
# For cloud PostgreSQL with SSL: Add uselibpqcompat=true&sslmode=require
# For local development: Use sslmode=disable

# DATABASE_URL="postgres://<user>:<password>@localhost:5432/<database>?uselibpqcompat=true&sslmode=require"

# NextAuth.js Configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl

# OAuth Providers (Optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
