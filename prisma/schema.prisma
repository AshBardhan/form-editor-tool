generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ENUMS
// ========================================

enum UserRole {
  CLIENT // Form creator (Phase 1)
  ADMIN // Platform admin (Phase 2)
}

enum FormTheme {
  light
  dark
}

enum FormStatus {
  draft
  published
  archived
}

// ========================================
// AUTHENTICATION & USER MANAGEMENT
// Supports both credentials (email/password) and OAuth providers
// ========================================

model User {
  id    Int      @id @default(autoincrement()) // Auto-increment primary key
  email String   @unique // Unique email for authentication
  name  String? // Optional display name
  role  UserRole @default(CLIENT) // User role (CLIENT creates forms, ADMIN manages platform)

  // Authentication fields
  password      String? // Hashed password for credentials provider (null for OAuth-only users)
  image         String? // Profile picture URL (from OAuth or uploaded)
  emailVerified DateTime? // Email verification timestamp (null if not verified)

  createdAt DateTime @default(now()) // Account creation timestamp
  updatedAt DateTime @updatedAt // Last profile update timestamp

  // Relations
  forms    Form[]    // 1-n: One user can create many forms
  accounts Account[] // 1-n: One user can have multiple auth providers (Google, GitHub, etc.)
  sessions Session[] // 1-n: One user can have multiple active sessions (multi-device)

  // Indexes
  @@index([email]) // Fast lookup during login
  @@index([role]) // Filter users by role
}

// ========================================
// NextAuth.js Authentication Tables
// ========================================

// Links users to OAuth providers (Google, GitHub, etc.)
model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String // "oauth", "email", "credentials"
  provider          String // "google", "github", "credentials"
  providerAccountId String // User ID from the provider
  refresh_token     String? @db.Text // OAuth refresh token
  access_token      String? @db.Text // OAuth access token
  expires_at        Int? // Token expiration timestamp
  token_type        String? // "Bearer", etc.
  scope             String? // OAuth scopes granted
  id_token          String? @db.Text // OpenID Connect ID token
  session_state     String? // OAuth session state

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId]) // One account per provider per user
  @@index([userId])
}

// Tracks active login sessions (for database session strategy)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Used for email verification and password reset tokens
model VerificationToken {
  identifier String // Email or phone number
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========================================
// Form Management
// ========================================

model Form {
  id          String     @id @default(cuid()) // Unique CUID for form identification
  title       String // Form title shown to creator and respondents
  description String? // Optional form description/instructions
  theme       FormTheme  @default(light) // Visual theme (light/dark mode)
  status      FormStatus @default(draft) // Lifecycle state (draft = editing, published = accepting responses)
  views       Int        @default(0) // Total public page visits for response rate calculations
  starts      Int        @default(0) // Sessions that started filling at least one field
  completions Int        @default(0) // Sessions that reached all required fields filled
  submitAttempts Int     @default(0) // Total submit button clicks (success + failure)

  // Form-wide submit/reset actions config (button themes are fixed in code, not persisted)
  submitLabel     String  @default("Submit") // Label shown on the submit button
  resetLabel      String  @default("Reset") // Label shown on the reset button
  actionsAlignment String @default("left") // Horizontal alignment: left, center, right, justified
  actionsReverse  Boolean @default(false) // Swap the visual order of submit/reset buttons
  hideReset       Boolean @default(false) // Hide the reset button entirely

  // Ownership
  userId Int // Foreign key to form creator
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade) // n-1: Many forms belong to one user

  // Public access
  slug String @unique // URL-friendly identifier (e.g., "contact-form" for /forms/contact-form) - always generated on creation

  createdAt   DateTime  @default(now()) // Form creation timestamp
  updatedAt   DateTime  @updatedAt // Last modification timestamp
  publishedAt DateTime? // When form was published (null if never published)

  // Relations
  blocks      FormBlock[] // 1-n: One form contains many blocks (fields/widgets)
  submissions FormSubmission[] // 1-n: One form can receive many submissions

  // Indexes
  @@index([userId]) // Fast query: get all forms by user
  @@index([status]) // Fast query: filter by draft/published
  @@index([slug]) // Fast lookup by public URL
  @@index([createdAt]) // Fast query: sort forms by creation date
}

model FormBlock {
  id     String @id @default(cuid()) // Unique CUID for block identification
  formId String // Foreign key to parent form
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade) // n-1: Many blocks belong to one form

  type  String // Widget type: "text", "textarea", "select", "checkbox", "radio", "heading", etc.
  name  String // Unique identifier within form (e.g., "text-abc123") - used as key in responses
  props Json // Flexible JSON storage for widget properties (label, placeholder, options, etc.)
  order Int // Display order within form (0-indexed)

  createdAt DateTime @default(now()) // Block creation timestamp
  updatedAt DateTime @updatedAt // Last modification timestamp

  // Relations
  responses FormFieldResponse[] // 1-n: One block can have many responses across submissions

  // Indexes
  @@index([formId]) // Fast query: get all blocks for a form
  @@index([formId, order]) // Fast query: get blocks in order for a specific form
}

// ========================================
// Form Submissions (Anonymous Respondents)
// ========================================

model FormSubmission {
  id     String @id @default(cuid()) // Unique CUID for submission identification
  formId String // Foreign key to submitted form
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade) // n-1: Many submissions belong to one form

  submittedAt DateTime @default(now()) // Submission timestamp

  // Relations
  responses FormFieldResponse[] // 1-n: One submission contains many field responses

  // Indexes
  @@index([formId]) // Fast query: get all submissions for a form
  @@index([submittedAt]) // Fast query: submissions over time for analytics
}

model FormFieldResponse {
  id           String         @id @default(cuid()) // Unique CUID for response identification
  submissionId String // Foreign key to parent submission
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade) // n-1: Many responses belong to one submission

  blockId String // Foreign key to form block
  block   FormBlock @relation(fields: [blockId], references: [id]) // n-1: Many responses reference one block
  value   Json // Flexible storage: string, number, boolean, array, or object

  // Indexes
  @@index([submissionId]) // Fast query: get all responses for a submission
  @@index([blockId]) // Fast query: analytics on specific field across all submissions
}
